# Projet Supabase (Settings > API dans le dashboard Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé publique VAPID (notifications push) -- peut réutiliser la même paire
# que pokedeals-saas, ou en générer une nouvelle (cf. README.md).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# URL absolue du site -- http://localhost:3000 en local, l'URL Vercel/le
# domaine en prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
